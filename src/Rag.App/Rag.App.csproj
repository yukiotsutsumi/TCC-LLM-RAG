<Project Sdk="Microsoft.NET.Sdk.Web">

	<ItemGroup>
		<ProjectReference Include="..\Rag.Api\Rag.Api.csproj" />
		<ProjectReference Include="..\Rag.Core\Rag.Core.csproj" />
