@page "/login"
@rendermode InteractiveServer
@using Rag.App.Components.Layout
@using Rag.Core.Domain.DTOs.Auth.Request
@layout EmptyLayout
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="auth-shell">
    <div class="auth-card">

        <div class="auth-logo">
            <div class="auth-logo-icon">✦</div>
            <span class="auth-logo-text">RAG<span>.</span>chat</span>
        </div>
        <p class="text-center mb-4" style="font-size: 0.78rem; color: var(--rag-text-muted);">
            Entre com suas credenciais para continuar
        </p>

        @if (Registered == "true")
        {
            <div class="alert alert-success d-flex align-items-center gap-2 py-2 mb-3">
                <span>✓</span> Conta criada! Faça login para continuar.
            </div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleLogin" FormName="LoginForm">
            <DataAnnotationsValidator />

            <div class="mb-3 slide-up stagger-1">
                <label class="form-label">Usuário</label>
                <InputText @bind-Value="_model.Username"
                           class="form-control"
                           placeholder="Seu nome de usuario" />
                <ValidationMessage For="() => _model.Username" />
            </div>

            <div class="mb-3 slide-up stagger-2">
                <label class="form-label">Senha</label>
                <InputText @bind-Value="_model.Password"
                           type="password"
                           class="form-control"
                           placeholder="Sua senha"/>
                <ValidationMessage For="() => _model.Password" />
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 py-2 mb-3">
                    <span>⚠</span> @_errorMessage
                </div>
            }

            <button type="submit"
                    class="btn btn-primary w-100 @(_isLoading ? "is-loading" : "") slide-up stagger-3"
                    disabled="@_isLoading">
                @(_isLoading ? "" : "Entrar")
            </button>
        </EditForm>

        <div class="auth-divider my-3">ou</div>

        <p class="text-center mb-0" style="font-size: 0.82rem; color: var(--rag-text-muted);">
            Não tem uma conta?
            <a href="/register" class="fw-semibold">Criar conta</a>
        </p>
    </div>
</div>

@code {
    private LoginRequest _model = new();
    private string? _errorMessage;
    private bool _isLoading;
    private bool _isSubmitting;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }


    [Parameter]
    [SupplyParameterFromQuery]
    public string? Registered { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var alreadyAuth = await JS.InvokeAsync<bool>("checkAuth");
        if (alreadyAuth)
            Nav.NavigateTo(ReturnUrl ?? "/home", forceLoad: true);
    }

    private async Task HandleLogin()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var success = await JS.InvokeAsync<bool>("loginUser",
                _model.Username,
                _model.Password,
                ReturnUrl ?? "/home");

            if (!success)
                _errorMessage = "Usuário ou senha inválidos.";
        }
        catch (Exception ex)
        {
            _errorMessage = "Erro ao realizar login. Tente novamente.";
            Console.Error.WriteLine($"Login error: {ex}");
        }
        finally
        {
            _isLoading = false;
            _isSubmitting = false;
        }
    }
}
