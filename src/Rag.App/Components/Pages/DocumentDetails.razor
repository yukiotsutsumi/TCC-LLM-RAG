@page "/ingest/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Rag.Core.Domain.DTOs.Documents
@using Rag.Core.Domain.DTOs.Documents.Response
@using Rag.App.Services
@inject IngestionServiceClient IngestionService
@inject NavigationManager Nav

<div class="ingest-page">

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border" role="status"></div>
        </div>
    }
    else if (_doc == null)
    {
        <div class="ingest-empty">
            <i class="bi bi-file-earmark-x"></i>
            <h5>Documento não encontrado</h5>
            <button class="btn btn-ghost mt-2" @onclick="GoBack">
                <i class="bi bi-arrow-left me-1"></i>Voltar
            </button>
        </div>
    }
    else
    {
        <div class="detail-header">
            <div class="d-flex align-items-start gap-3">
                <button class="btn btn-ghost btn-sm" @onclick="GoBack">
                    <i class="bi bi-arrow-left"></i>
                </button>

                <div>
                    <h1 class="ingest-title mb-1">@_doc.Title</h1>
                    <p class="ingest-subtitle mb-0">
                        Documento indexado na base da aplicação
                    </p>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-danger btn-sm @(_isDeleting ? "is-loading" : "")"
                        @onclick="ConfirmDelete"
                        disabled="@_isDeleting">
                    @(_isDeleting ? "" : "Excluir")
                </button>
            </div>
        </div>

        <div class="detail-grid">
            <div class="detail-main">
                <div class="card detail-card slide-up stagger-1">
                    <div class="card-header">Resumo do documento</div>
                    <div class="card-body">
                        <div class="detail-info-grid">
                            <div class="detail-info-item">
                                <div class="detail-info-label">Título</div>
                                <div class="detail-info-value">@_doc.Title</div>
                            </div>

                            <div class="detail-info-item">
                                <div class="detail-info-label">Status</div>
                                <div class="detail-info-value">
                                    <span class="badge @(_doc.Status == "ready" ? "badge-ready" : "badge-processing")">
                                        @(_doc.Status == "ready" ? "Pronto" : "Processando")
                                    </span>
                                </div>
                            </div>

                            <div class="detail-info-item">
                                <div class="detail-info-label">Indexado em</div>
                                <div class="detail-info-value">
                                    @_doc.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card detail-card slide-up stagger-2">
                    <div class="card-header">Observações</div>
                    <div class="card-body">
                        <p class="mb-0" style="color: #cbd5e1; line-height: 1.7;">
                            O nível de acesso definido para este documento influencia diretamente
                            sua elegibilidade na etapa de recuperação do pipeline RAG. Documentos
                            mais restritos deixam de compor o contexto para usuários sem permissão
                            compatível.
                        </p>
                    </div>
                </div>
            </div>

            <div class="detail-side">
                <div class="card detail-card slide-up stagger-2">
                    <div class="card-header">Controle de acesso</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="detail-info-label mb-2">Nível atual</div>
                            <span class="@GetAccessLevelBadgeClass(_doc.AccessLevel)">
                                @GetAccessLevelLabel(_doc.AccessLevel)
                            </span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Alterar nível de acesso</label>
                            <select class="form-select" @bind="_selectedAccessLevel">
                                <option value="@Rag.Core.Domain.Enums.DocumentAccessLevel.Public">Público</option>
                                <option value="@Rag.Core.Domain.Enums.DocumentAccessLevel.User">Usuário</option>
                                <option value="@Rag.Core.Domain.Enums.DocumentAccessLevel.Admin">Admin</option>
                            </select>
                        </div>

                        <button class="btn btn-primary w-100"
                                @onclick="SaveAccessLevelAsync"
                                disabled="@_isSavingAccess">
                            @(_isSavingAccess ? "Salvando..." : "Salvar alteração")
                        </button>
                    </div>
                </div>

                <div class="card detail-card slide-up stagger-3">
                    <div class="card-header">Estatísticas</div>
                    <div class="card-body">
                        <div class="stat-card compact-stat">
                            <div class="stat-label">Chunks</div>
                            <div class="stat-value">@_doc.ChunkCount</div>
                            <div class="stat-sub">fragmentos indexados</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3 fade-in">
                @_message
            </div>
        }
    }
</div>

@if (_showDeleteModal && _doc != null)
{
    <div class="modal-backdrop-custom" @onclick="CancelDelete"></div>
    <div class="modal-custom modal-sm">
        <div class="modal-custom-header">
            <span>Confirmar exclusão</span>
            <button class="btn-icon" @onclick="CancelDelete">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="modal-custom-body">
            <p style="color:var(--rag-text-muted); font-size:0.875rem;">
                Tem certeza que deseja excluir
                <strong style="color:var(--rag-text);">@_doc.Title</strong>?
                Esta ação não pode ser desfeita.
            </p>
        </div>
        <div class="modal-custom-footer">
            <button class="btn btn-ghost" @onclick="CancelDelete">Cancelar</button>
            <button class="btn btn-danger @(_isDeleting ? "is-loading" : "")"
                    @onclick="DoDelete"
                    disabled="@_isDeleting">
                @(_isDeleting ? "" : "Excluir")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private DocumentDto? _doc;
    private bool _isLoading = true;
    private bool _isDeleting = false;
    private bool _showDeleteModal = false;
    private bool _isSavingAccess = false;
    private string? _message;
    private bool _isError;
    private Rag.Core.Domain.Enums.DocumentAccessLevel _selectedAccessLevel;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _doc = await IngestionService.GetDocumentAsync(Id);
            if (_doc != null)
                _selectedAccessLevel = _doc.AccessLevel;
        }
        catch (Exception ex)
        {
            _message = $"Erro: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("/ingest");

    private void ConfirmDelete() => _showDeleteModal = true;
    private void CancelDelete() => _showDeleteModal = false;

    private async Task DoDelete()
    {
        if (_doc == null) return;
        _isDeleting = true;
        try
        {
            var ok = await IngestionService.DeleteDocumentAsync(_doc.Id);
            if (ok)
                Nav.NavigateTo("/ingest");
            else
            {
                _message = "Erro ao excluir documento.";
                _isError = true;
            }
        }
        catch (Exception ex)
        {
            _message = $"Erro: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isDeleting = false;
            _showDeleteModal = false;
        }
    }

    private async Task SaveAccessLevelAsync()
    {
        if (_doc == null) return;

        _isSavingAccess = true;
        _message = null;

        try
        {
            var ok = await IngestionService.UpdateDocumentAccessLevelAsync(_doc.Id, _selectedAccessLevel);
            if (ok)
            {
                _doc = await IngestionService.GetDocumentAsync(_doc.Id);
                if (_doc != null)
                    _selectedAccessLevel = _doc.AccessLevel;

                _message = "Nível de acesso atualizado.";
                _isError = false;
            }
            else
            {
                _message = "Não foi possível atualizar o nível de acesso.";
                _isError = true;
            }
        }
        catch (Exception ex)
        {
            _message = $"Erro ao atualizar nível: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isSavingAccess = false;
        }
    }

    private static string GetAccessLevelLabel(Rag.Core.Domain.Enums.DocumentAccessLevel level) => level switch
    {
        Rag.Core.Domain.Enums.DocumentAccessLevel.Public => "Público",
        Rag.Core.Domain.Enums.DocumentAccessLevel.User => "Usuário",
        Rag.Core.Domain.Enums.DocumentAccessLevel.Admin => "Admin",
        _ => "Desconhecido"
    };

    private static string GetAccessLevelBadgeClass(Rag.Core.Domain.Enums.DocumentAccessLevel level) => level switch
    {
        Rag.Core.Domain.Enums.DocumentAccessLevel.Public => "access-badge access-public",
        Rag.Core.Domain.Enums.DocumentAccessLevel.User => "access-badge access-user",
        Rag.Core.Domain.Enums.DocumentAccessLevel.Admin => "access-badge access-admin",
        _ => "access-badge"
    };
}