@page "/chat"
@rendermode InteractiveServer
@using Rag.Core.Domain.DTOs
@inject Rag.Core.Interfaces.Services.IRagService RagService

<h3>Chat</h3>

<textarea class="form-control mb-2" rows="3" @bind="question"></textarea>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-success" @onclick="AskRag" disabled="@isLoading">Perguntar (stream)</button>
    <button class="btn btn-secondary" @onclick="Cancel" disabled="!isLoading">Cancelar</button>
</div>

@if (!string.IsNullOrWhiteSpace(status))
{
    <div class="alert alert-info">@status</div>
}

@if (!string.IsNullOrEmpty(answer))
{
    <div class="card mt-3">
        <div class="card-header">Resposta</div>
        <div class="card-body">
            <pre class="mb-0">@answer</pre>
        </div>
    </div>
}

@if (sources?.Any() == true)
{
    <div class="mt-3">
        <h5>Fontes</h5>
        <ul class="list-group">
            @foreach (var s in sources)
            {
                <li class="list-group-item">
                    <div><strong>@s.Title</strong> <small class="text-muted">— @s.Source</small></div>
                    <div class="text-muted small">@s.Snippet</div>
                </li>
            }
        </ul>
    </div>
}

@code {
    private string question = "";
    private string answer = "";
    private string? status;
    private bool isLoading;
    private CancellationTokenSource? cts;
    private List<SourceRef>? sources;

    private async Task AskRag()
    {
        answer = "";
        sources = new List<SourceRef>();
        status = "Iniciando...";
        isLoading = true;
        StateHasChanged();

        cts = new CancellationTokenSource();

        var req = new AskRequest { Question = question, K = 5 };

        try
        {
            await foreach (var part in RagService.AskStreamAsync(req, cts.Token))
            {
                if (part.Kind == StreamPartKind.Delta && !string.IsNullOrEmpty(part.Delta))
                {
                    answer += part.Delta;
                    // atualiza a UI progressivamente
                    StateHasChanged();
                }
                else if (part.Kind == StreamPartKind.Finished && part.Sources != null)
                {
                    sources = part.Sources.ToList();
                    break;
                }
            }

            status = "Concluído";
        }
        catch (OperationCanceledException)
        {
            status = "Cancelado";
        }
        catch (Exception ex)
        {
            status = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            cts?.Dispose();
            cts = null;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        cts?.Cancel();
    }
}