@page "/chat"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Rag.Core.Domain.DTOs
@inject HttpClient Http

<h3>Chat</h3>

<div class="mb-3">
    <label class="form-label">Pergunta</label>
    <textarea class="form-control" rows="3" @bind="question"></textarea>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-primary" @onclick="AskDemo" disabled="@isLoading">Perguntar (demo)</button>
    <button type="button" class="btn btn-success" @onclick="AskRag" disabled="@isLoading">Perguntar (RAG)</button>
    <button type="button" class="btn btn-secondary" @onclick="Ping" disabled="@isLoading">Ping API</button>
</div>

@if (!string.IsNullOrWhiteSpace(status))
{
    <div class="alert alert-info">@status</div>
}

@if (resp is not null)
{
    <div class="card mt-3">
        <div class="card-header">
            Resposta @if (resp.TookMs > 0) {
            <span class="text-muted">(@resp.TookMs ms)</span>
        }
    </div>
    <div class="card-body">
        <pre class="mb-0">@resp.Answer</pre>
    </div>
</div>

@if (resp.Sources is not null && resp.Sources.Count > 0)
{
    <div class="mt-3">
        <h5>Fontes</h5>
        <ul class="list-group">
            @foreach (var s in resp.Sources)
            {
                <li class="list-group-item">
                    <div><strong>@s.Title</strong> <small class="text-muted">— @s.Source</small></div>
                    @if (!string.IsNullOrWhiteSpace(s.Snippet))
                    {
                        <div class="text-muted small">@s.Snippet</div>
                    }
                </li>
            }
        </ul>
    </div>
}
}

@code {
    private string question = "";
    private string? status;
    private bool isLoading;
    private AskResponse? resp;

    private async Task Ping()
    {
        try
        {
            isLoading = true; status = "Chamando /api/ping...";
            var r = await Http.GetFromJsonAsync<PingRes>("/api/ping");
            status = r is not null ? $"Ping ok: {r.ok} - {r.time:o}" : "Ping falhou";
        }
        catch (Exception ex)
        {
            status = $"Erro: {ex.Message}";
        }
        finally { isLoading = false; }
    }

    private async Task AskDemo()
    {
        await CallAsk("/api/ask-demo");
    }

    private async Task AskRag()
    {
        await CallAsk("/api/ask");
    }

    private async Task CallAsk(string url)  
    {  
        try  
        {  
            isLoading = true; status = $"Chamando {url}...";  
            Http.Timeout = TimeSpan.FromMinutes(10);
            var req = new AskRequest { Question = question, K = 5, MaxContextTokens = 2000 };  
            using var httpRes = await Http.PostAsJsonAsync(url, req);  
            httpRes.EnsureSuccessStatusCode();  
            resp = await httpRes.Content.ReadFromJsonAsync<AskResponse>();  
            status = "OK";  
        }  
        catch (Exception ex)  
        {  
            status = $"Erro: {ex.Message}";  
        }  
        finally { isLoading = false; }  
    }

    private class PingRes { public bool ok { get; set; } public DateTime time { get; set; } }
}