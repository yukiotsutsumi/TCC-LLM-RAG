@page "/chat"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Rag.App.Models
@using Rag.Core.Domain.DTOs
@using Rag.Core.Domain.DTOs.Ask.Requests
@using Rag.Core.Domain.DTOs.ResponseAI
@using Rag.Core.Interfaces.Services

@using Microsoft.Extensions.Caching.Memory
@inject IMemoryCache _cache

@inject IRagService RagService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<div class="chat-container">

    @* Aviso de conversa longa *@
    @if (_messages.Count(m => !m.IsUser) >= LongConversationThreshold)
    {
        <div class="chat-long-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Sua conversa está ficando longa. Recomendamos
            <button class="btn-link-inline" @onclick="NewConversation">iniciar uma nova conversa</button>
            para respostas de maior qualidade.
        </div>
    }

    @* Header *@
    <div class="chat-header">
        <i class="bi bi-robot me-2"></i>
        <span>Assistente IA</span>
        @if (isLoading)
        {
            <span class="ms-auto d-flex align-items-center gap-2 chat-thinking">
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
                pensando...
            </span>
        }
        else if (_messages.Any())
        {
            <div class="ms-auto d-flex gap-2">
                @if (_exportToken != null)
                {
               <a class="btn btn-ghost btn-sm"
                    href="/chat/export?token=@_exportToken"
                    target="_blank"
                    rel="noopener"
                    title="Exportar conversa">
                    <i class="bi bi-download me-1"></i>Exportar
                </a>
                }
                <button class="btn btn-ghost btn-sm"
                        @onclick="NewConversation"
                        title="Nova conversa">
                    <i class="bi bi-plus-circle me-1"></i>Nova conversa
                </button>
            </div>
        }
    </div>

    @* Mensagens *@
    <div class="chat-messages" id="chatWindow">

        @* Estado vazio *@
        @if (!_messages.Any())
        {
            <div class="chat-empty">
                <i class="bi bi-chat-dots"></i>
                <p>Faça uma pergunta para começar</p>
            </div>
        }

        @foreach (var msg in _messages)
        {
            <div class="message-wrapper @(msg.IsUser ? "user" : "assistant")">
                <div class="message-bubble">
                    <div class="message-content">
                        @if (msg.IsUser)
                        {
                            @msg.Content
                        }
                        else if (msg.IsStreaming && string.IsNullOrEmpty(msg.Content))
                        {
                            <div class="typing-indicator">
                                <span></span><span></span><span></span>
                            </div>
                        }
                        else
                        {
                            @((MarkupString)msg.Content.Replace("\n", "<br/>"))
                            @if (msg.IsStreaming)
                            {
                                <span class="stream-cursor">▋</span>
                            }
                        }
                    </div>

                    @* Fontes dentro da bolha *@
                    @if (!msg.IsStreaming && msg.Sources?.Any() == true)
                    {
                        <div class="message-sources">
                            <div class="sources-label">Fontes</div>
                            @foreach (var s in msg.Sources)
                            {
                                <div class="source-item-inline">
                                    <strong>@s.Title</strong>
                                    <small> — @s.Source</small>
                                    <div class="small mt-1 source-snippet">@s.Snippet</div>
                                </div>
                            }
                        </div>
                    }

                    @if (!msg.IsStreaming)
                    {
                        <div class="message-footer">
                            <small>@msg.Timestamp.ToString("HH:mm")</small>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @* Status *@
    @if (!string.IsNullOrWhiteSpace(status) && status != "Concluído")
    {
        <div class="chat-status">
            <small>@status</small>
        </div>
    }

    @* Input *@
    <div class="chat-input-area">
        <div class="input-wrapper">
            <textarea class="chat-textarea"
                      placeholder="Digite sua mensagem... (Enter para enviar, Shift+Enter para nova linha)"
                      @bind="question"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      rows="1"
                      disabled="@isLoading"></textarea>
            <div class="input-actions">
                @if (isLoading)
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick="Cancel">
                        <i class="bi bi-stop-fill"></i>
                    </button>
                }
                else
                {
                    <button class="btn btn-primary btn-sm send-btn"
                            @onclick="AskRag"
                            disabled="@(string.IsNullOrWhiteSpace(question))"
                            title="Enviar">
                        <i class="bi bi-send-fill"></i>
                    </button>
                }
            </div>
        </div>
    </div>

</div>

@code {
    private string question = "";
    private string status = "";
    private bool isLoading;
    private CancellationTokenSource? cts;
    private List<ChatMessage> _messages = new();
    private string? _exportToken;

    private const int RenderIntervalMs = 50;
    private const int MaxHistoryTurns = 5;        // trocas enviadas para a IA
    private const int LongConversationThreshold = 5; // respostas até mostrar aviso
    private DateTime _lastRender = DateTime.MinValue;

    private class ChatMessage
    {
        public string Content { get; set; } = "";
        public bool IsUser { get; set; }
        public bool IsStreaming { get; set; }
        public List<SourceRef>? Sources { get; set; }
        public DateTime Timestamp { get; set; } = DateTime.Now;
    }

    private void NewConversation()
    {
        if (isLoading) return;
        _messages.Clear();
        _exportToken = null;
        question = "";
        status = "";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await AskRag();
    }

    private List<HistoryMessage> BuildHistory()
    {
        // Pega as últimas MaxHistoryTurns trocas completas (user + assistant)
        // Exclui a última mensagem do assistente se ainda estiver streamando
        return _messages
            .Where(m => !m.IsStreaming)
            .TakeLast(MaxHistoryTurns * 2)
            .Select(m => new HistoryMessage(
                m.IsUser ? "user" : "assistant",
                m.Content))
            .ToList();
    }

    private async Task AskRag()
    {
        var userQuestion = question?.Trim();
        if (string.IsNullOrWhiteSpace(userQuestion) || isLoading) return;

        status = "Aguardando resposta...";
        isLoading = true;
        question = "";

        var history = BuildHistory();

        _messages.Add(new ChatMessage
        {
            Content = userQuestion,
            IsUser = true,
            Timestamp = DateTime.Now
        });

        var assistantMsg = new ChatMessage
        {
            IsUser = false,
            IsStreaming = true,
            Content = "",
            Sources = null
        };
        _messages.Add(assistantMsg);

        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();

        cts = new CancellationTokenSource();

        var req = new AskRequest
        {
            Question = userQuestion,
            K        = 5,
            History  = history
        };

        try
        {
            await foreach (var part in RagService.AskStreamAsync(req, cts.Token))
            {
                if (part.Kind == StreamPartKind.Delta && !string.IsNullOrEmpty(part.Delta))
                {
                    assistantMsg.Content += part.Delta;
                    status = "Gerando resposta...";

                    try
                    {
                        await InvokeAsync(StateHasChanged);
                        await ScrollToBottom();
                    }
                    catch (ObjectDisposedException) { break; }
                    catch (InvalidOperationException) { break; }
                }
                else if (part.Kind == StreamPartKind.Finished)
                {
                    if (part.Sources != null)
                        assistantMsg.Sources = part.Sources.ToList();

                    break;
                }
            }

            status = "Concluído";
        }
        catch (OperationCanceledException)
        {
            assistantMsg.Content += " [cancelado]";
            status = "Cancelado";
        }
        catch (Exception ex)
        {
            assistantMsg.Content = $"Erro: {ex.Message}";
            status = "Erro";
        }
        finally
        {
            assistantMsg.IsStreaming = false;
            assistantMsg.Timestamp  = DateTime.Now;
            isLoading = false;
            cts?.Dispose();
            cts = null;
            RefreshExportLink();
            try
            {
                await InvokeAsync(StateHasChanged);
                await ScrollToBottom();
            }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }
    }

    private void RefreshExportLink()
    {
        var completed = _messages.Where(m => !m.IsStreaming).ToList();
        if (!completed.Any())
        {
            Console.WriteLine(">>> RefreshExportLink: sem mensagens completas");
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("RAG.chat — Conversa exportada");
        sb.AppendLine($"Data: {DateTime.Now:dd/MM/yyyy HH:mm}");
        sb.AppendLine();

        foreach (var msg in completed)
            sb.AppendLine(msg.IsUser
                ? $"Você: {msg.Content}"
                : $"Assistente: {msg.Content}");

        _exportToken = Guid.NewGuid().ToString("N")[..16];

        _cache.Set($"chatexport:{_exportToken}",
            new ChatExportEntry
            {
                Content  = sb.ToString(),
                Filename = $"ragchat_{DateTime.Now:yyyyMMdd_HHmm}.txt"
            },
            TimeSpan.FromMinutes(30));

        Console.WriteLine($">>> RefreshExportLink: token={_exportToken} salvo no cache");
    }

    private void Cancel() => cts?.Cancel();

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
        cts = null;
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollChatToBottom", "chatWindow");
        }
        catch { }
    }
}
