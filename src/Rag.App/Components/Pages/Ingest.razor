@using Microsoft.AspNetCore.Authorization
@using Rag.Core.Domain.DTOs.Ingest.Requests
@using Rag.Core.Domain.DTOs.Ingest.Responses
@using Rag.Core.Interfaces.Services

@attribute [Authorize]
@page "/ingest"
@rendermode InteractiveServer

@inject IIngestionService IngestionService

<h3>Ingestão de Texto</h3>

<div class="mb-3">
    <label class="form-label">Título</label>
    <input class="form-control" @bind="title" />
</div>

<div class="mb-3">
    <label class="form-label">Fonte (URL, arquivo, etc)</label>
    <input class="form-control" @bind="source" />
</div>

<div class="mb-3">
    <label class="form-label">Texto</label>
    <textarea class="form-control" rows="10" @bind="text"></textarea>
</div>

<button type="button" class="btn btn-primary" @onclick="IngestAsync" disabled="@isLoading">
    Ingerir
</button>

@if (!string.IsNullOrWhiteSpace(status))
{
    <div class="alert alert-info mt-3">@status</div>
}

@if (result is not null)
{
    <div class="alert alert-success mt-3">
        DocumentId: @result.DocumentId — Chunks: @result.ChunksSaved
    </div>
}

@code {
    private string title = "";
    private string source = "";
    private string text = "";
    private bool isLoading;
    private string? status;
    private IngestTextResponse? result;

    private async Task IngestAsync()
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            status = "Texto não pode ser vazio.";
            return;
        }

        try
        {
            isLoading = true;
            status = "Enviando para ingestão...";

            var req = new IngestTextRequest(title, source, text);
            result = await IngestionService.IngestTextAsync(req);

            status = result.ChunksSaved > 0
                ? $"Concluído! {result.ChunksSaved} chunks salvos."
                : "Aviso: nenhum chunk foi salvo.";
        }
        catch (Exception ex)
        {
            status = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}